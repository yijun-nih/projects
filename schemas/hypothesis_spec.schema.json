{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis2omics.local/schemas/hypothesis_spec.schema.json",
  "title": "Hypothesis2Omics hypothesis specification",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["gene", "aliases", "outcome", "context", "species"],
  "properties": {
    "gene": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "species": {
      "type": "string",
      "minLength": 1
    }
  }
}
