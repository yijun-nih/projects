{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis2omics.local/schemas/judgment_provenance.schema.json",
  "title": "Hypothesis2Omics judgment provenance record",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "call_id",
    "stage",
    "judge_type",
    "model",
    "prompt",
    "prompt_version",
    "schema",
    "schema_id",
    "schema_version",
    "attempts",
    "validated_response",
    "status",
    "error",
    "timestamp_utc",
    "retries"
  ],
  "properties": {
    "call_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stage": {
      "enum": ["eligibility", "hypothesis_spec", "synthesis"]
    },
    "judge_type": {
      "enum": ["manual_relay", "api"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema": {
      "type": "object",
      "minProperties": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "validated_response": {
      "type": ["object", "null"]
    },
    "status": {
      "enum": ["success", "failed"]
    },
    "error": {
      "type": ["string", "null"]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "success"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validated_response": {"type": "object"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "validated_response": {"type": "null"},
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "raw_response",
        "validation_errors",
        "correction_prompt",
        "timestamp_utc"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "raw_response": {
          "type": "string"
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correction_prompt": {
          "type": ["string", "null"]
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
